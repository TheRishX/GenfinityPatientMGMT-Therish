GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"
# IANA timezone used for appointment dates/times and reminders.
APPOINTMENT_TIMEZONE="America/Los_Angeles"

# Hostinger Business deployment
# These values match the clinic site/database provisioned in Hostinger.
# Set MYSQL_PASSWORD in Hostinger's Node.js environment; never commit it.
NODE_ENV="production"
# Set to "true" only for local development when you intentionally want to
# connect to the remote Hostinger database. Deployments use MySQL by default.
MYSQL_USE_REMOTE="false"
MYSQL_HOST="srv946.hstgr.io"
MYSQL_PORT="3306"
MYSQL_DATABASE="u130063801_clinic"
MYSQL_USER="u130063801_app"
MYSQL_PASSWORD="replace_with_hostinger_mysql_password"
MYSQL_CONNECTION_LIMIT="8"
PRIVATE_STORAGE_PATH="../private-clinic-storage"
FILE_ENCRYPTION_KEY_BASE64="replace_with_32_byte_base64_key"

# Brevo email
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="replace_with_brevo_login"
BREVO_SMTP_PASSWORD="replace_with_brevo_smtp_key"

# Brevo API (recommended for patient email)
BREVO_API_KEY="replace_with_brevo_api_key"
BREVO_FROM_EMAIL="notifications@yourclinic.com"
BREVO_SENDER_NAME="Genfinity O&P"
BREVO_REPLY_TO=""

# RingCentral SMS (JWT application)
RC_SERVER_URL="https://platform.ringcentral.com"
RC_APP_CLIENT_ID="replace_with_ringcentral_client_id"
RC_APP_CLIENT_SECRET="replace_with_ringcentral_client_secret"
RC_USER_JWT="replace_with_ringcentral_user_jwt"
RC_FROM_PHONE_NUMBER="+15551234567"
