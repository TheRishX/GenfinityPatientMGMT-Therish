GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

# Hostinger Business deployment
NODE_ENV="production"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="genfinity_clinic_prod"
MYSQL_USER="genfinity_app"
MYSQL_PASSWORD="replace_with_hostinger_mysql_password"
MYSQL_CONNECTION_LIMIT="8"
PRIVATE_STORAGE_PATH="../private-clinic-storage"
FILE_ENCRYPTION_KEY_BASE64="replace_with_32_byte_base64_key"

# Brevo email
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="replace_with_brevo_login"
BREVO_SMTP_PASSWORD="replace_with_brevo_smtp_key"
